{
  "version": 1,
  "servers": [
    { "id": "s1", "droplet": "zoo-1", "domain": "s1.zoo.sorv.dev" },
    { "id": "s2", "droplet": "zoo-2", "domain": "s2.zoo.sorv.dev" },
    { "id": "s3", "droplet": "zoo-3", "domain": "s3.zoo.sorv.dev" },
    { "id": "s4", "droplet": "zoo-4", "domain": "s4.zoo.sorv.dev" }
