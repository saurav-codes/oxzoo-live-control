  "chains": [
    {
      "id": "event-river", "title": "C1 Event river", "starter": "celery-hub",
      "steps": {
        "celery-hub": ["queued", "worker-ledger", "sent"],
        "event-bus": ["ingested", "go-consumer", "py-forwarded"],
        "search-svc": ["received", "indexed"],
        "pipeline-py": ["clickhouse", "qdrant", "meili"]
      }
    },
    {
      "id": "shop-order", "title": "C2 Shop order", "starter": "mesh-shop",
      "steps": {
        "mesh-shop": ["order-created", "catalog-ok", "stock-reserved", "fulfilled", "webhook-sent"],
        "catalog-api": ["signed-lookup"],
        "rails-queue": ["webhook-received", "job-done"]
      }
    },
    {
      "id": "ping-pong", "title": "C3 Webhook ping-pong", "starter": "laravel-jobs",
      "steps": {
        "laravel-jobs": ["queued", "webhook-sent", "ack-received"],
        "rails-queue": ["webhook-received", "job-done", "ack-sent"]
      }
    },
    {
      "id": "ssr-fanout", "title": "C4 SSR fan-out", "starter": "sveltekit-ssr",
      "steps": {
        "sveltekit-ssr": ["catalog", "search", "axum"],
        "catalog-api": ["signed-lookup"],
        "axum-cache": ["signed-lookup"]
      }
    },
    {
      "id": "rabbit-relay", "title": "C5 Rabbit relay", "starter": "rabbit-relay",
      "steps": { "rabbit-relay": ["published", "consumed", "stored"] }
    }
  ],
